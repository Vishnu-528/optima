new file mode 100644
index 0000000..c36ed73
--- /dev/null
+++ b/src/optimamanager.h
@@ -0,0 +1,70 @@
+#pragma once
+
+#include <QString>
+
+#include "assembler/program.h"
+
+namespace Ripes {
+
+/**
+ * @brief The OptimaManager class
+ * Runs the Optima compiler (a Python script, optc.py) on a piece of Optima
+ * source code and returns the RISC-V assembly it generates. Ripes then
+ * assembles that text with its own assembler, exactly as if it had been typed
+ * into the editor.
+ *
+ * The compiler script is looked up in this order:
+ *   1. the "Optima compiler script" setting (Edit->Settings->Compiler)
+ *   2. the OPTIMA_COMPILER environment variable
+ *   3. the location given when Ripes was built (CMake option OPTIMA_DIR, by
+ *      default the "optima" directory in the Ripes source tree)
+ *   4. an "optima" directory next to (or up to three levels above) the Ripes
+ *      executable.
+ * The Python interpreter is the "Python interpreter" setting, or else the
+ * first of python3/python/py found in PATH that reports version 3.
+ */
+class OptimaManager {
+public:
+  struct Result {
+    /// True if assembly was generated.
+    bool success = false;
+    /// True if the compiler could not be run at all (as opposed to the
+    /// compiler reporting an error in the source code).
+    bool launchFailed = false;
+    /// The generated assembly program (if success).
+    QString assembly;
+    /// Zero-based source line of a compile error, or -1 if unknown.
+    int errorLine = -1;
+    /// Short error message (the compiler's own message, or why it could not
+    /// be run).
+    QString errorMessage;
+    /// Everything the compiler wrote to stderr.
+    QString errorOutput;
+  };
+
+  /// Compiles @p source. Never throws; inspect Result::success.
+  static Result compile(const QString &source);
+
+  /// Returns true if both a Python interpreter and the compiler script were
+  /// found. If not, @p reason (if non-null) describes what is missing.
+  static bool isAvailable(QString *reason = nullptr);
+
+  /// Resolved path of the compiler script, or an empty string if not found.
+  static QString compilerPath();
+  /// Resolved Python interpreter, or an empty string if not found.
+  static QString pythonPath();
+
+  /**
+   * @brief remapSource
+   * A program assembled from generated assembly has source mappings which
+   * refer to lines of that assembly. This function rewrites them to refer to
+   * lines of the Optima source instead, using the "# ---- line N:" comments
+   * that the compiler emits, and stamps the program with the hash of the
+   * Optima source. The editor can then highlight the Optima statement which
+   * each processor stage is currently executing.
+   */
+  static void remapSource(Program &program, const QString &assembly,
+                          const QString &optimaSource);
+};
+
+} // namespace Ripes
