@@ -0,0 +1,25 @@
+#pragma once
+
+#include <QRegularExpression>
+
+#include "syntaxhighlighter.h"
+
+namespace Ripes {
+
+/// Syntax highlighting for the Optima optimization language.
+class OptimaSyntaxHighlighter : public SyntaxHighlighter {
+public:
+  OptimaSyntaxHighlighter(QTextDocument *parent = nullptr,
+                          std::shared_ptr<Errors> errors = {});
+  void syntaxHighlightBlock(const QString &text) override;
+
+private:
+  struct HighlightingRule {
+    QRegularExpression pattern;
+    QTextCharFormat format;
+  };
+  QVector<HighlightingRule> m_highlightingRules;
+  QTextCharFormat m_commentFormat;
+};
+
+} // namespace Ripes
