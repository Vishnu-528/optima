diff --git a/src/optimamanager.cpp b/src/optimamanager.cpp
new file mode 100644
index 0000000..231fe2b
--- /dev/null
+++ b/src/optimamanager.cpp
@@ -0,0 +1,222 @@
+#include "optimamanager.h"
+
+#include <QCoreApplication>
+#include <QDir>
+#include <QFileInfo>
+#include <QRegularExpression>
+#include <QStringList>
+
+#ifdef RIPES_WITH_QPROCESS
+#include <QProcess>
+#endif
+
+#include "ripessettings.h"
+
+namespace Ripes {
+
+#ifdef RIPES_WITH_QPROCESS
+
+// Returns true if 'path' starts and identifies itself as Python 3.
+static bool isPython3(const QString &path) {
+  QProcess process;
+  process.start(path, {"--version"});
+  if (!process.waitForStarted(3000))
+    return false;
+  if (!process.waitForFinished(5000)) {
+    process.kill();
+    process.waitForFinished(1000);
+    return false;
+  }
+  if (process.exitStatus() != QProcess::NormalExit || process.exitCode() != 0)
+    return false;
+  const QString output = QString::fromLocal8Bit(
+      process.readAllStandardOutput() + process.readAllStandardError());
+  return output.trimmed().startsWith("Python 3");
+}
+
+QString OptimaManager::pythonPath() {
+  const QString setting =
+      RipesSettings::value(RIPES_SETTING_OPTIMA_PYTHON).toString().trimmed();
+  if (!setting.isEmpty())
+    return setting;
+
+  // Autodetect once; an interpreter does not appear or vanish while running.
+  static bool s_searched = false;
+  static QString s_detected;
+  if (!s_searched) {
+    s_searched = true;
+#ifdef Q_OS_WIN
+    const QStringList candidates = {"python", "py", "python3"};
+#else
+    const QStringList candidates = {"python3", "python"};
+#endif
+    for (const auto &candidate : candidates) {
+      if (isPython3(candidate)) {
+        s_detected = candidate;
+        break;
+      }
+    }
+  }
+  return s_detected;
+}
+
+#else // RIPES_WITH_QPROCESS
+
+QString OptimaManager::pythonPath() { return QString(); }
+
+#endif // RIPES_WITH_QPROCESS
+
+QString OptimaManager::compilerPath() {
+  const QString setting =
+      RipesSettings::value(RIPES_SETTING_OPTIMA_COMPILER).toString().trimmed();
+  if (!setting.isEmpty())
+    return QFileInfo(setting).isFile() ? setting : QString();
+
+  const QString env = qEnvironmentVariable("OPTIMA_COMPILER").trimmed();
+  if (!env.isEmpty() && QFileInfo(env).isFile())
+    return env;
+
+#ifdef OPTIMA_DEFAULT_COMPILER
+  // The location given when Ripes was built (by default <source>/optima).
+  if (QFileInfo(OPTIMA_DEFAULT_COMPILER).isFile())
+    return OPTIMA_DEFAULT_COMPILER;
+#endif
+
+  const QDir appDir(QCoreApplication::applicationDirPath());
+  const QStringList candidates = {
+      "optima/optc.py",
+      "../optima/optc.py",
+      "../../optima/optc.py",
+      "../../../optima/optc.py",
+      "../Resources/optima/optc.py",  // macOS bundle
+      "../share/ripes/optima/optc.py" // installed
+  };
+  for (const auto &candidate : candidates) {
+    const QFileInfo info(appDir.absoluteFilePath(candidate));
+    if (info.isFile())
+      return info.canonicalFilePath();
+  }
+  return QString();
+}
+
+bool OptimaManager::isAvailable(QString *reason) {
+#ifndef RIPES_WITH_QPROCESS
+  if (reason)
+    *reason = "This build of Ripes cannot start external programs.";
+  return false;
+#else
+  if (compilerPath().isEmpty()) {
+    if (reason) {
+      const QString setting =
+          RipesSettings::value(RIPES_SETTING_OPTIMA_COMPILER).toString();
+      *reason = setting.trimmed().isEmpty()
+                    ? QString("The Optima compiler script (optc.py) was not "
+                              "found.")
+                    : "The Optima compiler script '" + setting +
+                          "' does not exist.";
+    }
+    return false;
+  }
+  if (pythonPath().isEmpty()) {
+    if (reason)
+      *reason = "No Python 3 interpreter was found in PATH.";
+    return false;
+  }
+  return true;
+#endif
+}
+
+OptimaManager::Result OptimaManager::compile(const QString &source) {
+  Result result;
+  QString reason;
+  if (!isAvailable(&reason)) {
+    result.launchFailed = true;
+    result.errorMessage = reason;
+    return result;
+  }
+
+#ifdef RIPES_WITH_QPROCESS
+  // The source is sent on stdin and the assembly comes back on stdout, so no
+  // temporary files are needed:  python optc.py - -o -
+  const QString python = pythonPath();
+  QProcess process;
+  process.start(python, {compilerPath(), "-", "-o", "-"});
+  if (!process.waitForStarted(5000)) {
+    result.launchFailed = true;
+    result.errorMessage =
+        "Could not start '" + python + "': " + process.errorString();
+    return result;
+  }
+  process.write(source.toUtf8());
+  process.closeWriteChannel();
+  if (!process.waitForFinished(30000)) {
+    process.kill();
+    process.waitForFinished(1000);
+    result.launchFailed = true;
+    result.errorMessage = "The Optima compiler did not finish in time.";
+    return result;
+  }
+
+  const QString out = QString::fromUtf8(process.readAllStandardOutput());
+  result.errorOutput =
+      QString::fromUtf8(process.readAllStandardError()).trimmed();
+
+  if (process.exitStatus() == QProcess::NormalExit &&
+      process.exitCode() == 0) {
+    result.success = true;
+    result.assembly = out;
+    return result;
+  }
+
+  // Compile errors look like:  <stdin>:LINE:COLUMN: error: MESSAGE
+  static const QRegularExpression errorPattern(
+      R"(^[^\n]*?:(\d+):(\d+): error: ([^\n]*))",
+      QRegularExpression::MultilineOption);
+  const auto match = errorPattern.match(result.errorOutput);
+  if (match.hasMatch()) {
+    result.errorLine = match.captured(1).toInt() - 1;
+    result.errorMessage = match.captured(3) + " (column " +
+                          match.captured(2) + ")";
+  } else {
+    // Not a source error: the script itself failed (wrong path, a Python
+    // version that is too old, ...).
+    result.launchFailed = true;
+    result.errorMessage = result.errorOutput.isEmpty()
+                              ? QString("The Optima compiler failed.")
+                              : result.errorOutput;
+  }
+#endif
+  return result;
+}
+
+void OptimaManager::remapSource(Program &program, const QString &assembly,
+                                const QString &optimaSource) {
+  // For each line of the generated assembly, find the Optima line it came
+  // from (-1: none, e.g. the run-time library). "# ---- line N:" starts the
+  // code of source line N; any other "# ---- " comment ends it.
+  static const QRegularExpression lineMarker(R"(^\s*# ---- line (\d+):)");
+  static const QRegularExpression otherMarker(R"(^\s*# ---- )");
+  const QStringList asmLines = assembly.split('\n');
+  std::vector<int> origin(asmLines.size(), -1);
+  int current = -1;
+  for (qsizetype i = 0; i < asmLines.size(); ++i) {
+    const auto match = lineMarker.match(asmLines[i]);
+    if (match.hasMatch())
+      current = match.captured(1).toInt() - 1;
+    else if (otherMarker.match(asmLines[i]).hasMatch())
+      current = -1;
+    origin[i] = current;
+  }
+
+  Program::SourceMapping remapped;
+  for (const auto &entry : program.sourceMapping) {
+    for (const auto asmLine : entry.second) {
+      if (asmLine < origin.size() && origin[asmLine] >= 0)
+        remapped[entry.first].insert(origin[asmLine]);
+    }
+  }
+  program.sourceMapping = remapped;
+  program.sourceHash = Program::calculateHash(optimaSource.toUtf8());
+}
+
