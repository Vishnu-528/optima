+void EditTab::compileOptima(const QString &source) {
+  *m_sourceErrors = {};
+  m_optimaAssembly.clear();
+
+  // Reports an error on a line of the Optima source (shown like an assembler
+  // error: the line is underlined and the message is its tooltip).
+  auto fail = [this](int line, const QString &message) {
+    m_sourceErrors->push_back(Error(Location(line < 0 ? 0 : line), message));
+    m_ui->codeEditor->rehighlight();
+  };
+
+  // The generated code is 32-bit and uses multiply/divide instructions.
+  const auto isa = ProcessorHandler::currentISA();
+  if (isa->isaID() != ISA::RV32I || !isa->extensionEnabled("M")) {
+    fail(0, "Optima programs need a 32-bit RISC-V processor with the M "
+            "extension enabled. Pick one with 'Select processor'.");
+    return;
+  }
+
+  const auto res = OptimaManager::compile(source);
+  if (!res.success) {
+    fail(res.errorLine, res.launchFailed
+                            ? "Could not run the Optima compiler: " +
+                                  res.errorMessage
+                            : res.errorMessage);
+    return;
+  }
+
+  // Assemble the generated assembly as if it had been typed into the editor.
+  auto asmRes = ProcessorHandler::getAssembler()->assembleRaw(
+      res.assembly, &IOManager::get().assemblerSymbols());
+  m_optimaAssembly = res.assembly;
+  if (!asmRes.errors.empty()) {
+    const auto &first = asmRes.errors.front();
+    fail(0, "The assembly generated by the Optima compiler did not assemble "
+            "(assembly line " +
+                QString::number(first.sourceLine() + 1) +
+                ": " + first.errorMessage() +
+                "). See 'Generated assembly...'.");
+    return;
+  }
+
+  auto program = std::make_shared<Program>(asmRes.program);
+  // Make the program refer to lines of the Optima source instead of lines of
+  // the generated assembly, so that the editor can highlight the statement
+  // being executed.
+  OptimaManager::remapSource(*program, res.assembly, source);
+  ProcessorHandler::loadProgram(program);
+  m_ui->codeEditor->rehighlight();
+}
+
+void EditTab::showOptimaAssembly() {
+  QDialog dialog(this);
+  dialog.setWindowTitle("Assembly generated from the Optima program");
+  dialog.resize(760, 640);
+  auto *layout = new QVBoxLayout(&dialog);
+
+  auto *view = new QPlainTextEdit(&dialog);
+  view->setReadOnly(true);
+  view->setWordWrapMode(QTextOption::NoWrap);
+  view->setFont(QFont(Fonts::monospace, 11));
+  if (m_optimaAssembly.isEmpty()) {
+    view->setPlainText(
+        "# Nothing to show: the Optima program has not compiled successfully "
+        "yet.");
+  } else {
+    view->setPlainText(m_optimaAssembly);
+    // Parented to the document, which deletes it together with the dialog.
+    new RVSyntaxHighlighter(view->document(), std::make_shared<Errors>(),
+                            ProcessorHandler::getAssembler()->getOpcodes());
+  }
+  layout->addWidget(view);
+
+  auto *buttons = new QDialogButtonBox(
+      QDialogButtonBox::Save | QDialogButtonBox::Close, &dialog);
+  buttons->button(QDialogButtonBox::Save)
+      ->setEnabled(!m_optimaAssembly.isEmpty());
+  layout->addWidget(buttons);
+  connect(buttons, &QDialogButtonBox::rejected, &dialog, &QDialog::reject);
+  connect(buttons, &QDialogButtonBox::accepted, &dialog, [this, &dialog] {
+    const QString path = QFileDialog::getSaveFileName(
+        &dialog, "Save generated assembly", QString(),
+        "Assembly files (*.s);; All files (*.*)");
+    if (path.isEmpty())
+      return;
+    QFile file(path);
+    if (!file.open(QIODevice::WriteOnly | QIODevice::Text) ||
+        file.write(m_optimaAssembly.toUtf8()) < 0) {
+      QMessageBox::warning(&dialog, "File error",
+                           "Error when saving file: " + file.errorString());
+    }
+  });
+  dialog.exec();
+}
