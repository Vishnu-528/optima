+# Find the minimum of a bowl-shaped function of two variables.
+target = 3
+
+f(x, y) = (x - target)^2 + (y + 1)^2
+
+r = minimize f from (0, 0) using gradient_descent(lr=0.1, steps=500, tol=1e-6)
+
+print "minimum at", r
+print "value there:", f(r)
+print "iterations used:", iterations
+print "gradient at (1, 2):", gradient f at (1, 2)
+print "x =", r[0], " y =", r[1]
diff --git a/examples/optima/rosenbrock.opt b/examples/optima/rosenbrock.opt
new file mode 100644
index 0000000..9ba2b05
--- /dev/null
+++ b/examples/optima/rosenbrock.opt
@@ -0,0 +1,11 @@
+# The Rosenbrock "banana" function: a classic hard case for gradient descent.
+# Its minimum is at (1, 1). Newton's method uses the curvature and gets there
+# in a handful of steps.
+rosen(x, y) = (1 - x)^2 + 100 * (y - x^2)^2
+
+p = minimize rosen from (-1.2, 1) using newton(steps=50, tol=1e-5)
+print "newton:", p, "after", iterations, "iterations"
+print "rosen(p) =", rosen(p)
+
+q = minimize rosen from (-1.2, 1) using gradient_descent(lr=0.001, steps=300)
+print "gradient descent after", iterations, "steps is only at", q
