diff --git a/src/editor/optimasyntaxhighlighter.cpp b/src/editor/optimasyntaxhighlighter.cpp
new file mode 100644
index 0000000..621166b
--- /dev/null
+++ b/src/editor/optimasyntaxhighlighter.cpp
@@ -0,0 +1,76 @@
+#include "optimasyntaxhighlighter.h"
+
+#include <utility>
+
+#include "colors.h"
+
+namespace Ripes {
+
+OptimaSyntaxHighlighter::OptimaSyntaxHighlighter(QTextDocument *parent,
+                                                 std::shared_ptr<Errors> errors)
+    : SyntaxHighlighter(parent, std::move(errors)) {
+  const SyntaxColorScheme colors = currentSyntaxColors();
+  HighlightingRule rule;
+
+  // Function names: a word directly followed by '('
+  rule.format = QTextCharFormat();
+  rule.format.setForeground(colors.function);
+  rule.pattern = QRegularExpression(R"(\b[A-Za-z_][A-Za-z0-9_]*(?=\s*\())");
+  m_highlightingRules.append(rule);
+
+  // Numbers
+  rule.format = QTextCharFormat();
+  rule.format.setForeground(colors.immediate);
+  rule.pattern = QRegularExpression(
+      R"((?<![A-Za-z0-9_.])(\d+\.?\d*|\.\d+)([eE][-+]?\d+)?(?![A-Za-z_]))");
+  m_highlightingRules.append(rule);
+
+  // Keywords
+  rule.format = QTextCharFormat();
+  rule.format.setForeground(colors.keyword);
+  rule.format.setFontWeight(QFont::Bold);
+  rule.pattern = QRegularExpression(
+      R"(\b(print|minimize|maximize|from|using|gradient|at|iterations)\b)");
+  m_highlightingRules.append(rule);
+
+  // Solvers and built-in functions
+  rule.format = QTextCharFormat();
+  rule.format.setForeground(colors.type);
+  rule.format.setFontWeight(QFont::Bold);
+  rule.pattern = QRegularExpression(
+      R"(\b(gradient_descent|momentum|newton|sqrt|exp|log|sin|cos)\b)");
+  m_highlightingRules.append(rule);
+
+  // Strings
+  rule.format = QTextCharFormat();
+  rule.format.setForeground(colors.string);
+  rule.pattern = QRegularExpression(R"("[^"]*")");
+  m_highlightingRules.append(rule);
+
+  m_commentFormat.setForeground(colors.comment);
+}
+
+void OptimaSyntaxHighlighter::syntaxHighlightBlock(const QString &text) {
+  for (const HighlightingRule &rule : std::as_const(m_highlightingRules)) {
+    QRegularExpressionMatchIterator matchIterator =
+        rule.pattern.globalMatch(text);
+    while (matchIterator.hasNext()) {
+      QRegularExpressionMatch match = matchIterator.next();
+      setFormat(match.capturedStart(), match.capturedLength(), rule.format);
+    }
+  }
+
+  // A comment runs from the first '#' outside a string to the end of the
+  // line, and wins over everything else.
+  bool inString = false;
+  for (int i = 0; i < text.length(); ++i) {
+    if (text[i] == '"') {
+      inString = !inString;
+    } else if (text[i] == '#' && !inString) {
+      setFormat(i, text.length() - i, m_commentFormat);
+      break;
+    }
+  }
+}
+
+} // namespace Ripes
